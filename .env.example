# MongoDB connection string.
# Local dev default (requires a local mongod running):
MONGODB_URI=mongodb://localhost:27017/demo-preview-tool
# Production (MongoDB Atlas free tier) example:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/demo-preview-tool?retryWrites=true&w=majority

# Public base URL used to build shareable preview links.
# Local dev:
BASE_URL=http://localhost:3000
# Render deployment example:
# BASE_URL=https://your-service-name.onrender.com

# Botza widget embed script URL.
BOTZA_WIDGET_SCRIPT_URL=https://botza.panscience.xyz/widget/chatbot-widget.js

# Chatbot ID to use for these demo previews.
DEMO_CHATBOT_ID=3af1c684-1391-48a3-b01d-2f36215c52a5

# Port the server listens on.
PORT=3000
